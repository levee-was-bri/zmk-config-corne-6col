#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        HMRF: HMRF {
            compatible = "zmk,behavior-hold-tap";
            label = "HMRF";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
        };

        HMRS: HMRS {
            compatible = "zmk,behavior-hold-tap";
            label = "HMRS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
        };

        LHKPT: LHKPT {
            compatible = "zmk,behavior-hold-tap";
            label = "LHKPT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "balanced";
            quick-tap-ms = <200>;
        };

        hrmf_mmv: hrmf_mmv {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMF_MMV";
            bindings = <&kp>, <&mmv>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        enter_combo {
            bindings = <&kp ENTER>;
            key-positions = <21 20>;
        };

        function_layer {
            bindings = <&tog 3>;
            key-positions = <36 41 38 39>;
        };

        soft_off {
            bindings = <&soft_off>;
            key-positions = <2 26>;
            layers = <2>;
        };

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <15 16>;
        };

        Escape_combo {
            bindings = <&kp ESC>;
            key-positions = <15 14>;
        };
    };

    macros {
        moonlight_mouse: moonlight_mouse {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(LS(M)))>;
            label = "MOONLIGHT_MOUSE";
        };

        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp LEFT_CONTROL &kp LEFT_ALT &kp LEFT_GUI>;
            label = "HYPER";
        };

        meh: meh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT_SHIFT &kp LEFT_ALT>;
            label = "MEH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TILDE                  &kp Q                           &kp W             &kp E             &kp R                 &kp T                         &kp Y           &kp U                 &kp I             &kp O             &kp P                              &kp BSLH
&kp TAB                    &HMRF LC(LA(LG(LEFT_SHIFT))) A  &HMRF LEFT_ALT S  &HMRF LEFT_GUI D  &HMRF LEFT_CONTROL F  &kp G                         &kp H           &HMRF LEFT_CONTROL J  &HMRF LEFT_GUI K  &HMRF LEFT_ALT L  &HMRF LA(LC(LG(LEFT_SHIFT))) SEMI  &kp SQT
&HMRF LEFT_CONTROL ESCAPE  &kp Z                           &kp X             &LHKPT 4 C        &kp V                 &kp B                         &kp N           &kp M                 &kp COMMA         &kp DOT           &kp FSLH                           &kp MINUS
                                                                             &kp DELETE        &HMRS GLOBE ESCAPE    &HMRS LEFT_SHIFT BACKSPACE    &LHKPT 1 SPACE  &LHKPT 2 TAB          &kp ENTER
            >;
        };

        Number {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE  &kp NUMBER_1                               &kp NUMBER_2                  &kp NUMBER_3                     &kp NUMBER_4                          &kp N5       &kp NUMBER_6  &kp N7                   &kp N8             &kp N9                &kp N0                      &trans
&kp CARET  &HMRF LA(LC(LG(LEFT_SHIFT))) LEFT_BRACKET  &HMRF LEFT_ALT RIGHT_BRACKET  &HMRF LEFT_GUI LEFT_PARENTHESIS  &HMRF LEFT_CONTROL RIGHT_PARENTHESIS  &kp EQUAL    &kp LEFT      &HMRF LEFT_CONTROL DOWN  &HMRF LEFT_GUI UP  &HMRF LEFT_ALT RIGHT  &kp LA(LC(LG(LEFT_SHIFT)))  &kp DOLLAR
&none      &none                                      &kp DOT                       &kp LEFT_BRACE                   &kp RIGHT_BRACE                       &kp PLUS     &kp HOME      &kp PAGE_DOWN            &kp PAGE_UP        &kp END               &none                       &trans
                                                                                    &trans                           &trans                                &trans       &trans        &trans                   &trans
            >;
        };

        function {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp F12          &kp F1                                         &kp F2                           &kp F3                        &kp F4                          &kp F5              &kp F6  &kp F7            &kp F8        &kp F9        &kp F10                     &kp F11
&kp PRINTSCREEN  &HMRF LA(LC(LG(LEFT_SHIFT))) C_BRIGHTNESS_DEC  &HMRF LEFT_ALT C_BRIGHTNESS_INC  &HMRF LEFT_GUI C_VOLUME_DOWN  &HMRF LEFT_CONTROL C_VOLUME_UP  &kp C_PLAY_PAUSE    &none   &kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp LA(LC(LG(LEFT_SHIFT)))  &none
&bt BT_SEL 0     &bt BT_SEL 1                                   &bt BT_SEL 2                     &bt BT_SEL 3                  &bt BT_SEL 4                    &out OUT_TOG        &none   &msc SCRL_DOWN    &msc SCRL_UP  &none         &none                       &bt BT_CLR
                                                                                                 &trans                        &trans                          &trans              &trans  &trans            &trans
            >;
        };

        gaming {
            bindings = <
&kp ESC   &kp NUMBER_1  &kp Q  &kp W  &kp E             &kp R        &trans  &trans  &trans  &trans  &trans  &none
&kp TAB   &kp NUMBER_2  &kp A  &kp S  &kp D             &kp F        &trans  &trans  &trans  &trans  &trans  &none
&kp CAPS  &kp NUMBER_3  &kp Z  &kp X  &kp C             &kp V        &trans  &kp M   &trans  &trans  &trans  &none
                               &kp T  &kp LEFT_CONTROL  &kp SPACE    &trans  &trans  &trans
            >;
        };

        mouse_layer {
            bindings = <
&trans  &trans        &trans         &trans    &trans            &trans      &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans        &trans         &trans    &trans            &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &kp LEFT_ALT  &kp LEFT_META  &trans    &kp LEFT_CONTROL  &trans      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &trans
                                     &mkp MB3  &mkp MB2          &mkp MB1    &mkp MB1        &mkp MB2        &mkp MB3
            >;
        };
    };
};
